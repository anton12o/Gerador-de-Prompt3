# Chave da API do Google Gemini (obtenha em https://aistudio.google.com/)
GEMINI_API_KEY=

# Modelo padrão do Gemini para geração e fallback
GEMINI_MODEL=gemini-3.8-flash

# Configurações do servidor backend local
HOST=127.0.0.1
PORT=8000

# Origens permitidas para CORS (ajuste se o frontend rodar em outra porta)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
